# Obligatoria - Clave de API de Anthropic para usar el modelo Claude:
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional - Modelo a usar:
CHATBOT_MODEL=claude-sonnet-5

# Opcional - Maximo de tokens que genera el modelo por respuesta:
CHATBOT_MAX_TOKENS=2048

# Opcional - Registro de servidores MCP:
CHATBOT_MCP_CONFIG=config/mcp_servers.json

# Opcional - Carpeta donde se escribe el log de interacciones MCP:
CHATBOT_LOG_DIR=logs

# Opcional - Poner en 1 para imprimir cada intercambio MCP en consola conforme ocurre:
CHATBOT_ECHO_MCP_LOG=0